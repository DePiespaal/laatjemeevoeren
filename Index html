<!DOCTYPE html>
<html>
<head>
<title>System Access</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
    body {
        background-color: #0b0c10;
        color: #45a29e;
        font-family: 'Courier New', Courier, monospace;
        font-size: 14px;
        padding: 20px;
        overflow-x: hidden;
    }
    #console {
        white-space: pre-wrap;
        line-height: 1.5;
    }
    .cursor {
        display: inline-block;
        width: 8px;
        height: 15px;
        background-color: #45a29e;
        animation: blink 1s step-end infinite;
        vertical-align: middle;
    }
    @keyframes blink { 
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
</style>
</head>
<body>
    <div id="console"></div>
    <span class="cursor"></span>

    <script>
        const lines = [
            "Connection established...",
            "Bypassing standard security protocols...",
            "Analyzing recent chat dump...",
            "Extracting geographical hypotheses...",
            "> Hypothesis found: 'Voeren' (Source: Nele)",
            "Validating coordinates for target 'Voeren'...",
            "[WARNING] Destination deemed too predictable.",
            "[WARNING] Hypothesis rejected.",
            "Decrypting actual destination file...",
            "{LOADER}",
            "FATAL ERROR: Unauthorized access attempt detected.",
            "Initiating connection termination...",
            "System message: Kust allemaal nog steeds mijn kloten."
        ];

        let lineIndex = 0;
        let charIndex = 0;
        const consoleEl = document.getElementById('console');

        function runLoader() {
            consoleEl.innerHTML += 'Loading sector data: [<span id="bar">--------------------</span>] <span id="perc">0</span>%<br>';
            const barEl = document.getElementById('bar');
            const percEl = document.getElementById('perc');
            let perc = 0;
            
            let interval = setInterval(() => {
                perc += Math.floor(Math.random() * 8) + 1;
                if (perc >= 99) {
                    perc = 99;
                    clearInterval(interval);
                    barEl.innerText = "###################-";
                    percEl.innerText = perc;
                    
                    setTimeout(() => {
                        lineIndex++;
                        typeWriter();
                    }, 2500); 
                } else {
                    let blocks = Math.floor(perc / 5);
                    barEl.innerText = "#".repeat(blocks).padEnd(20, '-');
                    percEl.innerText = perc;
                }
            }, 80);
        }

        function typeWriter() {
            if (lineIndex < lines.length) {
                if (lines[lineIndex] === "{LOADER}") {
                    runLoader();
                    return;
                }

                if (charIndex < lines[lineIndex].length) {
                    consoleEl.innerHTML += lines[lineIndex].charAt(charIndex);
                    charIndex++;
                    let speed = Math.random() * 30 + 10;
                    setTimeout(typeWriter, speed);
                } else {
                    consoleEl.innerHTML += "<br>";
                    lineIndex++;
                    charIndex = 0;
                    
                    let pause = 400;
                    if (lineIndex === 5 || lineIndex === 8) pause = 1200;
                    
                    setTimeout(typeWriter, pause);
                }
            }
        }
        
        setTimeout(typeWriter, 800);
    </script>
</body>
</html>
